# Dev build oracle for the reverse-adoption branch (adopt-3.0.0).
# Purpose: compile feedback for the 3.0.0 base swap + migration work.
# Does NOT publish releases and does NOT touch main.
name: Dev Build (adopt-3.0.0 oracle)

on:
  push:
    branches: [ "adopt-3.0.0" ]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
        with:
          fetch-depth: 1

      - name: Set up JDK 21
        uses: actions/setup-java@v5
        with:
          java-version: '21'
          distribution: 'temurin'

      - name: Setup Node.js + pnpm
        uses: pnpm/action-setup@v6
        with:
          version: 10

      - name: Install web-ui deps (if present)
        run: |
          if [ -d web-ui ]; then cd web-ui && pnpm install --no-frozen-lockfile; else echo "no web-ui dir"; fi

      - name: Setup Android SDK
        uses: android-actions/setup-android@v4
        continue-on-error: true

      - name: Install SDK components
        run: |
          export PATH="$(ls -d $ANDROID_HOME/cmdline-tools/*/bin | head -1):$PATH"
          yes | sdkmanager --licenses || true
          sdkmanager "platforms;android-36" "build-tools;36.0.0" "platform-tools" || true
          sdkmanager "platforms;android-37" "build-tools;37.0.0" 2>/dev/null || true
          sdkmanager "ndk;28.2.13676358" 2>/dev/null || true

      - name: Compile oracle (assembleDebug)
        run: |
          ./gradlew :app:assembleDebug --no-daemon --stacktrace

      - name: Upload APK (informational)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: dev-debug-apk
          path: app/build/outputs/apk/**/*.apk
          if-no-files-found: ignore
