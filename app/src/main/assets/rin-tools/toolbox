#!/bin/sh
# toolbox — list the built-in tools available in this sandbox and check the
# environment (python3 / pandoc / python libraries). Part of the RinCore
# workspace provision (assets/rin-tools), injected into /usr/local/bin.

echo "=== Built-in tools (in /usr/local/bin, already on PATH) ==="
print_tool() {
    name="$1"; desc="$2"; usage="$3"
    if command -v "$name" >/dev/null 2>&1; then
        echo "  [ok] $name — $desc"
        echo "       usage: $usage"
    else
        echo "  [MISSING] $name — expected at /usr/local/bin/$name"
        echo "       (re-open the app so workspace provisioning re-injects it)"
    fi
}
print_tool officecli "full Office suite for AI: read / edit / render / batch / template merge (.docx .xlsx .pptx)" \
    'officecli view <f> text|screenshot|html|issues · officecli add|set|remove|move <f> <path> ... · officecli batch <f> --commands "[{...}]" · officecli merge <f> data.json'
print_tool office-edit "edit EXISTING .docx/.pptx/.xlsx without losing formatting (patches only touched parts; atomic)" \
    'office-edit docx|pptx read <file> · office-edit docx|pptx replace <file> "old" "new" · office-edit xlsx read <file> / office-edit xlsx set <file> <sheet> <cell> "value"'
print_tool apply-patch "Codex-style multi-file patch applier; hunks located by context, whole patch is one transaction" \
    "apply-patch <<'PATCH' ... *** Begin Patch / *** Update File: <path> / @@ <context> / -old / +new / *** End Patch ... PATCH"
print_tool office-check "delivery QA — structural check + leftover placeholder scan for .docx/.pptx/.xlsx" \
    'office-check <file.docx|.pptx|.xlsx>'
print_tool doc ".doc (Word 97-2003) read / edit — wraps Spire.Doc with proot fixes (auto setarch -R + evaluation-notice scrub)" \
    'doc read <f.doc> · doc replace <f.doc> "old" "new" [-o out.doc]  (requires: pip3 install --break-system-packages spire.doc)'
print_tool pdfmd "PDF -> Markdown for LLM context (pymupdf4llm wrapper; auto OCR for scanned pages)" \
    'pdfmd <f.pdf> [-o out.md]  (requires: pip3 install --break-system-packages pymupdf4llm)'

echo ""
echo "=== Environment ==="
if command -v python3 >/dev/null 2>&1; then
    echo "  python3  : $(python3 --version 2>&1) ($(command -v python3))"
    python3 - <<'PYEOF'
mods = ["docx", "openpyxl", "pptx", "reportlab", "pandas", "markitdown"]
missing = []
for m in mods:
    try:
        __import__(m)
    except Exception:
        missing.append(m)
if missing:
    print("  py libs  : missing: " + ", ".join(missing))
    print("             install: pip3 install " + " ".join(missing))
else:
        print("  py libs  : python-docx / openpyxl / python-pptx / reportlab / pandas / markitdown — all ready")
try:
    __import__("spire.doc")
    print("  spire.doc: ready (.doc read/edit via the `doc` wrapper)")
except Exception:
    print("  spire.doc: not installed — optional; for .doc read/edit run:")
    print("             pip3 install --break-system-packages spire.doc   (~25MB, one-time)")
PYEOF
else
    echo "  python3  : MISSING — office-edit / apply-patch / office-check need it"
    echo "             install: apt-get update && apt-get install -y python3 python3-pip"
fi
if command -v pandoc >/dev/null 2>&1; then
    echo "  pandoc   : $(pandoc --version 2>/dev/null | head -1) ($(command -v pandoc))"
else
    echo "  pandoc   : not installed (optional; install: apt-get update && apt-get install -y pandoc)"
fi

echo ""
echo "=== Notes ==="
echo "  [!] LibreOffice / soffice: NOT available in this sandbox (proot has no standard"
echo "      /proc mount - LibreOffice aborts at startup; unfixable in-sandbox)."
echo "      \"soffice\" / \"libreoffice\" commands hit shims that explain this. For document"
echo "      preview/rendering use: officecli view <file> screenshot  (or html)."

echo ""
echo "=== Workflow hints ==="
echo "  1. Read a file before editing it."
echo "  2. Office documents -> officecli (full suite); tiny in-place swaps -> office-edit;"
echo "     legacy .doc read/edit -> doc; code/text edits -> apply-patch; format conversion -> pandoc;"
echo "     document content as text -> markitdown; programmatic build -> python3."
echo "  3. After a successful apply-patch, do NOT re-read the file — the tool result is authoritative."
echo "  4. Run office-check before delivering any .docx/.pptx/.xlsx."
