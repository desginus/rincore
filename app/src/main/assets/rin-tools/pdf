#!/usr/bin/env python3
"""pdf — read a PDF without altering anything.

Default: print the embedded text layer — if the PDF carries its own text,
that IS the document's data and you read it as-is. Scanned PDFs (no text
layer) print a hint instead of guessing.
Nothing is ever written next to your document: --png renders into a temp
folder (/tmp/rin-pdf-pages) purely for viewing; --ocr extracts text from
scans only when text is explicitly needed.

Usage:
  pdf <file.pdf>            print the embedded text layer
  pdf <file.pdf> --png      render pages to PNG in /tmp/rin-pdf-pages (view them)
  pdf <file.pdf> --ocr      OCR text extraction (scanned PDFs, explicit need)
"""
import os
import sys

PNG_DIR = "/tmp/rin-pdf-pages"


def render_png(src: str) -> None:
    import pymupdf

    os.makedirs(PNG_DIR, exist_ok=True)
    base = os.path.splitext(os.path.basename(src))[0]
    doc = pymupdf.open(src)
    made = []
    for i, page in enumerate(doc):
        out = os.path.join(PNG_DIR, f"{base}-page{i + 1}.png")
        page.get_pixmap(dpi=150).save(out)
        made.append(out)
    doc.close()
    for p in made:
        print(p)
    print(f"({len(made)} page(s) rendered for viewing)", file=sys.stderr)


def extract_text(src: str, ocr: bool) -> None:
    import pymupdf

    doc = pymupdf.open(src)
    parts = []
    for i, page in enumerate(doc):
        if ocr:
            textpage = page.get_textpage_ocr(full=True, dpi=200)
            t = page.get_text(textpage=textpage)
        else:
            t = page.get_text()
        if t.strip():
            parts.append(f"=== page {i + 1} ===\n{t.strip()}")
    doc.close()
    if parts:
        print("\n\n".join(parts))
    else:
        print("(no text layer — scanned PDF)")
        print("view the pages instead:  pdf <file.pdf> --png")
        print("or force OCR text:       pdf <file.pdf> --ocr")


def main() -> None:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return
    src = args[0]
    if "--png" in args:
        render_png(src)
    elif "--ocr" in args:
        extract_text(src, ocr=True)
    else:
        extract_text(src, ocr=False)


if __name__ == "__main__":
    main()
