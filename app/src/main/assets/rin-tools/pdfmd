#!/usr/bin/env python3
"""pdfmd — PDF to Markdown for LLM context (pymupdf4llm wrapper).

Handles text PDFs and scanned PDFs (falls back to Tesseract OCR automatically).
Use it when you need the CONTENT of a PDF as clean text; use `officecli` or
`PyMuPDF` when you need programmatic PDF manipulation instead.

Usage:
  pdfmd <file.pdf>            print Markdown to stdout
  pdfmd <file.pdf> -o out.md  write to a file
"""
import os
import sys


def _quiet_to_stderr(func, *args, **kwargs):
    """pymupdf4llm prints C-level parser messages to fd 1; reroute to fd 2
    so stdout stays pure Markdown (pipe-friendly)."""
    saved = os.dup(1)
    try:
        os.dup2(2, 1)
        return func(*args, **kwargs)
    finally:
        os.dup2(saved, 1)
        os.close(saved)


def main() -> None:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return
    try:
        import pymupdf4llm
    except ImportError:
        print("pymupdf4llm is not installed. One-time install:")
        print("  pip3 install --break-system-packages pymupdf4llm")
        sys.exit(1)

    src = args[0]
    md = _quiet_to_stderr(pymupdf4llm.to_markdown, src)
    if "-o" in args:
        out = args[args.index("-o") + 1]
        with open(out, "w", encoding="utf-8") as f:
            f.write(md)
        print(f"markdown written -> {out} ({len(md)} chars)")
    else:
        print(md)


if __name__ == "__main__":
    main()
